{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JarvisMissionModel",
  "description": "Formal schema for J.A.R.V.I.S. Autonomous Missions and Execution DAGs",
  "type": "object",
  "required": [
    "mission_id",
    "goal",
    "status",
    "created_utc",
    "dag"
  ],
  "properties": {
    "mission_id": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "PLANNING",
        "SCHEDULED",
        "RUNNING",
        "VERIFYING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "completed_utc": {
      "type": [
        "string",
        "null"
      ]
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_iterations": {
          "type": "integer",
          "minimum": 1
        },
        "max_token_budget": {
          "type": "integer",
          "minimum": 0
        },
        "max_runtime_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "dag": {
      "type": "object",
      "required": [
        "nodes",
        "edges"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "task_id",
              "title",
              "status"
            ],
            "properties": {
              "task_id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "agent_profile": {
                "type": "string"
              },
              "required_skills": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "read_scopes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "write_scopes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "status": {
                "type": "string",
                "enum": [
                  "PENDING",
                  "READY",
                  "RUNNING",
                  "EXECUTED",
                  "VERIFIED",
                  "FAILED",
                  "CANCELLED",
                  "SKIPPED"
                ]
              },
              "verification_requirements": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "check_type",
                    "expected"
                  ],
                  "properties": {
                    "check_type": {
                      "type": "string"
                    },
                    "target": {
                      "type": "string"
                    },
                    "expected": {},
                    "status": {
                      "type": "string",
                      "enum": [
                        "UNVERIFIED",
                        "VERIFYING",
                        "VERIFIED",
                        "FAILED"
                      ]
                    },
                    "evidence": {}
                  }
                }
              },
              "artifacts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "execution_result": {},
              "retry_count": {
                "type": "integer",
                "minimum": 0
              },
              "schema_version": {
                "type": "string",
                "const": "1.0.0"
              },
              "max_retries": {
                "type": "integer",
                "minimum": 0
              },
              "timeout_seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "node_id": {
                "type": "string",
                "minLength": 1
              },
              "risk_level": {
                "enum": [
                  "UNKNOWN",
                  "LOW",
                  "MEDIUM",
                  "HIGH",
                  "CRITICAL"
                ]
              },
              "estimated_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "estimated_cost_usd": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            }
          }
        },
        "schema_version": {
          "type": "string",
          "const": "1.0.0"
        }
      }
    },
    "evidence_ledger": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    }
  }
}
