{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JarvisCognitiveVault",
  "description": "Formal schema for J.A.R.V.I.S. Cognitive Vault Integration and Context Synthesis",
  "type": "object",
  "required": ["profile", "memories", "validated_heuristics_count", "synced_utc"],
  "properties": {
    "profile": {
      "type": "object",
      "required": ["user_name", "primary_stack", "operational_rules"],
      "properties": {
        "user_name": {"type": "string"},
        "primary_stack": {"type": "string"},
        "preferred_tone": {"type": "string"},
        "operational_rules": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "memories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "fact"],
        "properties": {
          "id": {"type": "string"},
          "category": {"type": "string"},
          "fact": {"type": "string"},
          "importance": {"type": "string"}
        }
      }
    },
    "validated_heuristics_count": {"type": "integer", "minimum": 0},
    "synced_utc": {"type": "string", "format": "date-time"}
  }
}
