{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skill-registry:identity-cluster:1.0.0",
  "title": "Skill Registry Identity Cluster Schema",
  "description": "Canonical schema for identity clusters, deduplication relationships, and canonical resource leader resolution.",
  "x-skill-registry-schema-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cluster_id",
    "cluster_type",
    "canonical_name",
    "leader_resource_id",
    "member_count",
    "members",
    "resolution_policy",
    "created_utc",
    "updated_utc"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "cluster_id": {
      "type": "string",
      "pattern": "^idcl-[0-9]{8}T[0-9]{9}Z-[0-9a-f]{8}$"
    },
    "cluster_type": {
      "type": "string",
      "enum": [
        "SINGLETON",
        "EXACT_DUPLICATE_GROUP",
        "MULTI_ORIGIN_MIRROR_GROUP",
        "VERSION_LINEAGE_GROUP",
        "CONTENT_CLONE_GROUP",
        "CONTENT_DRIFT_GROUP",
        "NAME_COLLISION_GROUP"
      ]
    },
    "canonical_name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "leader_resource_id": {
      "type": "string",
      "pattern": "^sres-v1-sha256:[0-9a-f]{64}$"
    },
    "member_count": {
      "type": "integer",
      "minimum": 1
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource_id",
          "relationship",
          "is_leader",
          "version",
          "trust_level",
          "lifecycle_state"
        ],
        "properties": {
          "resource_id": { "type": "string", "pattern": "^sres-v1-sha256:[0-9a-f]{64}$" },
          "relationship": {
            "type": "string",
            "enum": [
              "LEADER",
              "EXACT_MATCH",
              "MULTI_ORIGIN_MIRROR",
              "CONTENT_CLONE_DIFFERENT_NAME",
              "VERSION_EVOLUTION",
              "CONTENT_DRIFT_SAME_VERSION",
              "NAME_COLLISION_DIFFERENT_CONTENT",
              "UNIQUE_RESOURCE"
            ]
          },
          "is_leader": { "type": "boolean" },
          "version": { "type": "string" },
          "trust_level": {
            "type": "string",
            "enum": ["BLOCKED", "UNTRUSTED", "PROVISIONAL", "REVIEWED", "TRUSTED"]
          },
          "lifecycle_state": {
            "type": "string",
            "enum": [
              "DISCOVERED",
              "CANDIDATE",
              "EVALUATED",
              "VERIFIED",
              "ELIGIBLE",
              "STAGED",
              "ACTIVE",
              "DEPRECATED",
              "RETIRED",
              "BLOCKED",
              "QUARANTINED"
            ]
          },
          "content_hash": {
            "oneOf": [
              { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              { "type": "null" }
            ]
          },
          "provenance_id": {
            "oneOf": [
              { "type": "string", "pattern": "^prov-v1-sha256:[0-9a-f]{64}$" },
              { "type": "null" }
            ]
          },
          "origin_uri": { "type": ["string", "null"] }
        }
      }
    },
    "divergence_analysis": {
      "type": "object",
      "additionalProperties": true
    },
    "resolution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_name", "selection_criteria", "deterministic_precedence"],
      "properties": {
        "policy_name": { "type": "string" },
        "selection_criteria": { "type": "string" },
        "deterministic_precedence": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "audit_transaction_id": { "type": "string" },
    "created_utc": { "$ref": "#/$defs/timestamp" },
    "updated_utc": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
