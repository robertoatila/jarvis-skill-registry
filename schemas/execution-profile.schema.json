{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-registry.local/schemas/execution-profile.schema.json",
  "title": "ExecutionProfile",
  "description": "Schema for Execution Profiles and Runtime Sandbox Specifications in the Skill Registry platform",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "profile_name",
    "target_trust_level",
    "isolation_level",
    "network_policy",
    "filesystem_policy",
    "process_limits",
    "env_variable_policy",
    "created_utc"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "profile_id": {
      "type": "string",
      "pattern": "^prof-[a-z0-9-]+-v[0-9]+$"
    },
    "profile_name": {
      "type": "string",
      "enum": ["STRICT_SANDBOX", "OFFLINE_DEVELOPER", "NETWORK_RESTRICTED", "PROVIDER_NATIVE"]
    },
    "description": {
      "type": "string"
    },
    "target_trust_level": {
      "type": "string",
      "enum": ["UNTRUSTED", "PROMOTABLE", "VERIFIED_CANONICAL", "SYSTEM_CORE"]
    },
    "isolation_level": {
      "type": "string",
      "enum": ["MAXIMUM", "HIGH", "RESTRICTED", "PROVIDER_DELEGATED"]
    },
    "network_policy": {
      "type": "string",
      "enum": ["BLOCKED", "LOOPBACK_ONLY", "RESTRICTED_WHITELIST", "PROVIDER_CONTROLLED"]
    },
    "allowed_domains": {
      "type": "array",
      "items": { "type": "string" }
    },
    "filesystem_policy": {
      "type": "string",
      "enum": ["ISOLATED_TEMP_EPHEMERAL", "WORKSPACE_TEMP_READWRITE", "READ_ONLY_BIND", "PROVIDER_SANDBOX"]
    },
    "process_limits": {
      "type": "object",
      "required": ["max_runtime_seconds", "max_memory_mb", "max_cpu_percent", "allow_child_processes"],
      "properties": {
        "max_runtime_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "max_memory_mb": { "type": "integer", "minimum": 16, "maximum": 65536 },
        "max_cpu_percent": { "type": "integer", "minimum": 1, "maximum": 100 },
        "allow_child_processes": { "type": "boolean" }
      }
    },
    "env_variable_policy": {
      "type": "string",
      "enum": ["CLEAN_ISOLATED", "SAFE_WHITELIST", "AUDITED_WHITELIST", "PROVIDER_MANAGED"]
    },
    "whitelisted_env_vars": {
      "type": "array",
      "items": { "type": "string" }
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "audit_transaction_id": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": false
}
