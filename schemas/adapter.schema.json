{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skill-registry:adapter:1.0.0",
  "title": "Skill Registry Provider Adapter Schema",
  "description": "Definition of translation/adaptation rules for exporting skills across runtimes.",
  "x-skill-registry-schema-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter_id",
    "target_provider",
    "transformation_mode",
    "parameters",
    "version"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "adapter_id": { "type": "string", "pattern": "^adp-[a-z0-9]+(-[a-z0-9]+)*$" },
    "target_provider": {
      "type": "string",
      "enum": ["GEMINI", "CODEX", "CLAUDE", "OPENAI", "GENERIC_AGENT"]
    },
    "transformation_mode": {
      "type": "string",
      "enum": ["PASSTHROUGH", "SKILL_MD_TO_SYSTEM_PROMPT", "PROMPT_TO_TOOL", "MULTI_AGENT_SPEC"]
    },
    "parameters": {
      "type": "object",
      "additionalProperties": true
    },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
  }
}
