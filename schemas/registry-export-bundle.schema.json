{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-registry.local/schemas/registry-export-bundle.schema.json",
  "title": "RegistryMetadataExportManifest",
  "description": "Schema #33, format 2.0.0: unsigned metadata-only export. It records scoped SHA-256 consistency data and makes no publisher-authentication or OCI/tar packaging claim.",
  "type": "object",
  "required": [
    "export_id",
    "bundle_type",
    "export_format_version",
    "created_utc",
    "registry_metadata",
    "quarantine_anchor",
    "catalog_snapshot",
    "manifest_counts",
    "bundle_payload",
    "trust",
    "limitations"
  ],
  "properties": {
    "export_id": {
      "type": "string",
      "pattern": "^exp-\\d{8}T\\d{6}\\d{3}Z-[a-f0-9]{8}$"
    },
    "bundle_type": { "const": "METADATA_ONLY" },
    "export_format_version": { "const": "2.0.0" },
    "created_utc": { "type": "string", "format": "date-time" },
    "registry_metadata": {
      "type": "object",
      "required": ["registry_id", "registry_name", "version", "mode"],
      "properties": {
        "registry_id": { "type": "string" },
        "registry_name": { "type": "string" },
        "version": { "type": "string" },
        "mode": { "type": "string" }
      },
      "additionalProperties": false
    },
    "quarantine_anchor": {
      "type": "object",
      "required": ["link_id", "snapshot_id", "tombstones_count", "blocked_containers_count"],
      "properties": {
        "link_id": { "type": "string" },
        "snapshot_id": { "type": "string" },
        "tombstones_count": { "type": "integer", "minimum": 0 },
        "blocked_containers_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "catalog_snapshot": {
      "type": "object",
      "required": ["sha256", "algorithm", "file_count", "included_paths"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "algorithm": { "const": "SHA-256 over UTF-8 newline-delimited sorted relative-path and file-hash rows" },
        "file_count": { "type": "integer", "minimum": 1 },
        "included_paths": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "manifest_counts": {
      "type": "object",
      "required": ["schemas_count", "indices_count", "sources_count", "resources_count", "deployments_count"],
      "properties": {
        "schemas_count": { "type": "integer", "minimum": 0 },
        "indices_count": { "type": "integer", "minimum": 0 },
        "sources_count": { "type": "integer", "minimum": 0 },
        "resources_count": { "type": "integer", "minimum": 0 },
        "deployments_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "bundle_payload": {
      "type": "object",
      "required": ["payload_type", "file_path", "byte_size", "sha256_hash"],
      "properties": {
        "payload_type": { "const": "METADATA_JSON" },
        "file_path": { "type": "string", "minLength": 1 },
        "byte_size": { "type": "integer", "minimum": 1 },
        "sha256_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "trust": {
      "type": "object",
      "required": ["signature_status", "signature_verified", "publisher_authentication", "canonical_merkle_verified"],
      "properties": {
        "signature_status": { "const": "UNSIGNED" },
        "signature_verified": { "const": false },
        "publisher_authentication": { "const": "NOT_ESTABLISHED" },
        "canonical_merkle_verified": { "const": false }
      },
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
