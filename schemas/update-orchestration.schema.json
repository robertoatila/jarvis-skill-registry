{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skill-registry:update-orchestration:1.0.0",
  "title": "Skill Registry Update Orchestration Schema",
  "description": "Schema for update queue orchestration, batch scheduling, multi-stage policy evaluation, and governed promotion.",
  "x-skill-registry-schema-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "queue_id",
    "status",
    "created_utc",
    "policy_configuration",
    "items",
    "batch_metrics"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "queue_id": {
      "type": "string",
      "pattern": "^orch-queue-[0-9]{8}T[0-9]{6,9}Z-[a-f0-9]{8}$"
    },
    "status": {
      "type": "string",
      "enum": ["PENDING", "PROCESSING", "COMPLETED", "FAILED", "CANCELLED"]
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "completed_utc": {
      "type": ["string", "null"]
    },
    "policy_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_quality_score",
        "allowed_risk_levels",
        "require_human_approval",
        "quarantine_precedence"
      ],
      "properties": {
        "min_quality_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "allowed_risk_levels": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["CLEAN", "LOW_RISK", "MEDIUM_RISK", "HIGH_RISK", "CRITICAL_RISK"]
          }
        },
        "require_human_approval": {
          "type": "boolean"
        },
        "quarantine_precedence": {
          "type": "boolean"
        },
        "max_batch_size": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "queue_item_id",
          "resource_id",
          "canonical_name",
          "priority_score",
          "priority_category",
          "dedup_hash",
          "status",
          "enqueued_utc"
        ],
        "properties": {
          "queue_item_id": { "type": "string" },
          "resource_id": {
            "type": "string",
            "pattern": "^(res|sres)-v1-sha256:[0-9a-f]{64}$"
          },
          "canonical_name": { "type": "string", "minLength": 1 },
          "source_id": { "type": "string" },
          "upstream_locator": { "type": "string" },
          "priority_score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "priority_category": {
            "type": "string",
            "enum": [
              "CRITICAL_SECURITY",
              "SECURITY_PATCH",
              "BREAKING_CHANGE",
              "STRUCTURAL_CHANGE",
              "CONTENT_UPDATE",
              "METADATA_PATCH"
            ]
          },
          "dedup_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "status": {
            "type": "string",
            "enum": ["QUEUED", "EVALUATING", "STAGED", "PROMOTED", "REJECTED", "DEFERRED"]
          },
          "update_id": { "type": ["string", "null"] },
          "enqueued_utc": { "type": "string", "format": "date-time" },
          "evaluation_summary": {
            "type": ["object", "null"],
            "additionalProperties": true
          },
          "promotion_record": {
            "type": ["object", "null"],
            "additionalProperties": true
          }
        }
      }
    },
    "batch_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_enqueued",
        "total_staged",
        "total_promoted",
        "total_rejected",
        "total_deferred"
      ],
      "properties": {
        "total_enqueued": { "type": "integer", "minimum": 0 },
        "total_staged": { "type": "integer", "minimum": 0 },
        "total_promoted": { "type": "integer", "minimum": 0 },
        "total_rejected": { "type": "integer", "minimum": 0 },
        "total_deferred": { "type": "integer", "minimum": 0 }
      }
    },
    "audit_transaction_id": {
      "type": ["string", "null"]
    }
  }
}
