{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skill-registry:resource:1.0.0",
  "title": "Skill Registry Resource Schema",
  "description": "Canonical schema for a skill resource representation decoupled from physical payload.",
  "x-skill-registry-schema-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "resource_id",
    "canonical_name",
    "version",
    "display_name",
    "description",
    "provenance_id",
    "lifecycle_state",
    "trust_level",
    "capabilities",
    "content_identity",
    "created_utc",
    "updated_utc"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "resource_id": { "type": "string", "pattern": "^sres-v1-sha256:[0-9a-f]{64}$" },
    "canonical_name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$" },
    "display_name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "provenance_id": { "type": "string", "pattern": "^prov-v1-sha256:[0-9a-f]{64}$" },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "DISCOVERED",
        "CANDIDATE",
        "EVALUATED",
        "VERIFIED",
        "ELIGIBLE",
        "STAGED",
        "ACTIVE",
        "DEPRECATED",
        "RETIRED",
        "BLOCKED",
        "QUARANTINED"
      ]
    },
    "trust_level": {
      "type": "string",
      "enum": ["BLOCKED", "UNTRUSTED", "PROVISIONAL", "REVIEWED", "TRUSTED"]
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "uniqueItems": true
    },
    "content_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_hash", "manifest_hash", "file_count", "byte_sum"],
      "properties": {
        "content_hash": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "manifest_hash": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "file_count": { "type": ["integer", "null"], "minimum": 0 },
        "byte_sum": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "created_utc": { "$ref": "#/$defs/timestamp" },
    "updated_utc": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
