{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JarvisAgentTelemetrySpan",
  "description": "Formal schema for J.A.R.V.I.S. Agent Execution Spans and Telemetry",
  "type": "object",
  "required": [
    "span_id",
    "mission_id",
    "task_id",
    "agent_id",
    "status",
    "start_utc",
    "duration_ms"
  ],
  "properties": {
    "span_id": {"type": "string"},
    "mission_id": {"type": "string"},
    "task_id": {"type": "string"},
    "agent_id": {"type": "string"},
    "skill_id": {"type": "string"},
    "wave_index": {"type": "integer", "minimum": 0},
    "status": {
      "type": "string",
      "enum": ["RUNNING", "SUCCESS", "FAIL", "CANCELLED"]
    },
    "start_utc": {"type": "string", "format": "date-time"},
    "end_utc": {"type": ["string", "null"]},
    "duration_ms": {"type": "integer", "minimum": 0},
    "token_usage": {
      "type": "object",
      "properties": {
        "prompt_tokens": {"type": "integer", "minimum": 0},
        "completion_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "tool_calls_count": {"type": "integer", "minimum": 0},
    "error_message": {"type": ["string", "null"]},
    "evidence_summary": {"type": "object"}
  }
}
